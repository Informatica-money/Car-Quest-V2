  <!-- ==================== JAVASCRIPT INTERACTIVITEIT ==================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      try {
        /* -----------------------------------------------------------
         * 1. Mobiel Navigatiemenu Toggle
         * ----------------------------------------------------------- */
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIconOpen = document.getElementById('menu-icon-open');
        const menuIconClose = document.getElementById('menu-icon-close');
        const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

        function toggleMobileMenu(forceClose = false) {
          const isCurrentlyOpen = !mobileMenu.classList.contains('hidden');
          const shouldOpen = forceClose ? false : !isCurrentlyOpen;

          mobileMenu.classList.toggle('hidden', !shouldOpen);
          menuIconOpen.classList.toggle('hidden', shouldOpen);
          menuIconClose.classList.toggle('hidden', !shouldOpen);
          mobileMenuBtn.setAttribute('aria-expanded', String(shouldOpen));
        }

        if (mobileMenuBtn) {
          mobileMenuBtn.addEventListener('click', () => toggleMobileMenu());
        }

        mobileNavLinks.forEach(link => {
          link.addEventListener('click', () => toggleMobileMenu(true));
        });

        /* -----------------------------------------------------------
         * 2. Interactieve Dashboard-Preview in de Hero-sectie
         * ----------------------------------------------------------- */
        const previewTabBtns = document.querySelectorAll('.preview-tab-btn');
        const previewPanels = document.querySelectorAll('.preview-panel');

        previewTabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const targetTab = btn.getAttribute('data-preview-tab');

            // Reset stijlen van alle tabknoppen
            previewTabBtns.forEach(b => {
              b.classList.remove('bg-indigo-50', 'text-indigo-700', 'font-semibold');
              b.classList.add('text-slate-600', 'font-medium');
            });

            // Activeer aangeklikte tabknop
            btn.classList.add('bg-indigo-50', 'text-indigo-700', 'font-semibold');
            btn.classList.remove('text-slate-600', 'font-medium');

            // Toon juiste paneel
            previewPanels.forEach(panel => {
              panel.classList.toggle('hidden', panel.id !== `preview-panel-${targetTab}`);
            });
          });
        });

        // Live voortgangsbalk bij afvinken van demo-taken
        const demoCheckboxes = document.querySelectorAll('.demo-checkbox');
        const demoProgressText = document.getElementById('demo-progress-text');
        const demoProgressBar = document.getElementById('demo-progress-bar');

        function updateDemoProgress() {
          const total = demoCheckboxes.length;
          let checkedCount = 0;

          demoCheckboxes.forEach(cb => {
            const labelText = cb.closest('.demo-task').querySelector('.demo-task-label');
            if (cb.checked) {
              checkedCount++;
              labelText.classList.add('line-through', 'text-slate-400');
              labelText.classList.remove('text-slate-800');
            } else {
              labelText.classList.remove('line-through', 'text-slate-400');
              labelText.classList.add('text-slate-800');
            }
          });

          const percentage = total > 0 ? Math.round((checkedCount / total) * 100) : 0;
          if (demoProgressText) demoProgressText.textContent = `${percentage}%`;
          if (demoProgressBar) demoProgressBar.style.width = `${percentage}%`;
        }

        demoCheckboxes.forEach(cb => {
          cb.addEventListener('change', updateDemoProgress);
        });

        /* -----------------------------------------------------------
         * 3. Interactieve Prijzen Toggle (Maandelijks vs. Jaarlijks)
         * ----------------------------------------------------------- */
        const billingToggle = document.getElementById('billing-toggle');
        const billingKnob = document.getElementById('billing-toggle-knob');
        const labelMonthly = document.getElementById('label-monthly');
        const labelYearly = document.getElementById('label-yearly');
        const priceAmounts = document.querySelectorAll('.price-amount');
        const billingNotes = document.querySelectorAll('.billing-note');

        let isYearly = false;

        if (billingToggle) {
          billingToggle.addEventListener('click', () => {
            isYearly = !isYearly;
            billingToggle.setAttribute('aria-checked', String(isYearly));

            // Wissel knop-positie en achtergrondkleur
            if (isYearly) {
              billingToggle.classList.remove('bg-slate-300');
              billingToggle.classList.add('bg-indigo-600');
              billingKnob.classList.remove('translate-x-0');
              billingKnob.classList.add('translate-x-6');

              labelYearly.classList.add('font-bold', 'text-slate-900');
              labelYearly.classList.remove('font-medium', 'text-slate-500');
              labelMonthly.classList.remove('font-bold', 'text-slate-900');
              labelMonthly.classList.add('font-medium', 'text-slate-500');
            } else {
              billingToggle.classList.add('bg-slate-300');
              billingToggle.classList.remove('bg-indigo-600');
              billingKnob.classList.add('translate-x-0');
              billingKnob.classList.remove('translate-x-6');

              labelMonthly.classList.add('font-bold', 'text-slate-900');
              labelMonthly.classList.remove('font-medium', 'text-slate-500');
              labelYearly.classList.remove('font-bold', 'text-slate-900');
              labelYearly.classList.add('font-medium', 'text-slate-500');
            }

            // Update bedragen en facturatietekst
            priceAmounts.forEach(el => {
              const newPrice = isYearly ? el.getAttribute('data-yearly') : el.getAttribute('data-monthly');
              el.textContent = `€${newPrice}`;
            });

            billingNotes.forEach((note, index) => {
              if (index === 0) {
                note.textContent = 'Altijd gratis te gebruiken';
              } else {
                note.textContent = isYearly ? 'Jaarlijks gefactureerd (20% korting)' : 'Maandelijks opzegbaar';
              }
            });
          });
        }

        // Pakket-knoppen koppelen aan het aanmeldformulier
        const selectPlanBtns = document.querySelectorAll('.select-plan-btn');
        const selectedPlanDropdown = document.getElementById('selected-plan');
        const planBanner = document.getElementById('plan-selected-banner');
        const planBannerText = document.getElementById('plan-selected-text');
        const closePlanBanner = document.getElementById('close-plan-banner');
        const signupSection = document.getElementById('aanmelden');

        selectPlanBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const chosenPlan = btn.getAttribute('data-select-plan');
            if (selectedPlanDropdown) {
              selectedPlanDropdown.value = chosenPlan;
            }
            if (planBanner && planBannerText) {
              const periodLabel = chosenPlan === 'Gratis' ? '' : (isYearly ? ' (Jaarlijks)' : ' (Maandelijks)');
              planBannerText.textContent = `Gekozen pakket: ${chosenPlan}${periodLabel}`;
              planBanner.classList.remove('hidden');
            }
            if (signupSection) {
              signupSection.scrollIntoView({ behavior: 'smooth' });
            }
          });
        });

        if (closePlanBanner && planBanner) {
          closePlanBanner.addEventListener('click', () => {
            planBanner.classList.add('hidden');
          });
        }

        /* -----------------------------------------------------------
         * 4. Validatie & Bevestiging van het Early Access Formulier
         * ----------------------------------------------------------- */
        const earlyAccessForm = document.getElementById('early-access-form');
        const nameInput = document.getElementById('full-name');
        const emailInput = document.getElementById('email-address');
        const roleSelect = document.getElementById('user-role');
        const errorName = document.getElementById('error-name');
        const errorEmail = document.getElementById('error-email');
        const successBox = document.getElementById('form-success-box');
        const successMessageText = document.getElementById('success-message-text');
        const resetFormBtn = document.getElementById('reset-form-btn');

        function isValidEmail(email) {
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        }

        if (earlyAccessForm) {
          earlyAccessForm.addEventListener('submit', (event) => {
            event.preventDefault();

            const nameVal = nameInput.value.trim();
            const emailVal = emailInput.value.trim();
            let isFormValid = true;

            // Valideer naam
            if (nameVal.length < 2) {
              errorName.classList.remove('hidden');
              nameInput.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
              isFormValid = false;
            } else {
              errorName.classList.add('hidden');
              nameInput.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
            }

            // Valideer e-mailadres
            if (!isValidEmail(emailVal)) {
              errorEmail.classList.remove('hidden');
              emailInput.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
              isFormValid = false;
            } else {
              errorEmail.classList.add('hidden');
              emailInput.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
            }

            if (!isFormValid) return;

            // Toon persoonlijke bevestigingsmelding
            const chosenRole = roleSelect ? roleSelect.value : 'Team';
            const chosenPlan = selectedPlanDropdown ? selectedPlanDropdown.value : 'Pro';

            successMessageText.innerHTML = `Bedankt, <strong>${escapeHtml(nameVal)}</strong>! We hebben een uitnodiging voor het <strong>${escapeHtml(chosenPlan)}</strong>-pakket (${escapeHtml(chosenRole)}) klaargezet voor <strong>${escapeHtml(emailVal)}</strong>.`;

            earlyAccessForm.classList.add('hidden');
            if (planBanner) planBanner.classList.add('hidden');
            successBox.classList.remove('hidden');
          });
        }

        // Resetknop om nog een persoon aan te melden
        if (resetFormBtn) {
          resetFormBtn.addEventListener('click', () => {
            earlyAccessForm.reset();
            successBox.classList.add('hidden');
            earlyAccessForm.classList.remove('hidden');
          });
        }

        // Hulpfunctie om XSS bij gebruikersinvoer te voorkomen
        function escapeHtml(str) {
          const div = document.createElement('div');
          div.textContent = str;
          return div.innerHTML;
        }
      } catch (err) {
        console.error('Fout tijdens initialiseren van de landingspagina:', err);
      }
    });
  </script>
</body>
</html>
